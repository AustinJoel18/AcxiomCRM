{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/acxiomcrm.db"
  },
  "App": {
    "TimeZoneId": "Asia/Kolkata",
    "EnableApiDocs": false
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Security": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 4
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    },
    "AllowSelfRegistration": true,
    "PasswordHistoryCount": 3,
    "SessionTimeoutMinutes": 30,
    "SessionRevalidationMinutes": 1,
    "LoginRateLimitPerMinute": 10,
    "ManagerCanViewAudit": true
  },
  "Jwt": {
    "Issuer": "AcxiomCRM",
    "Audience": "AcxiomCRM.Api",
    "AccessTokenMinutes": 60
  },
  "Validation": {
    "PhonePattern": "^[6-9]\\d{9}$",
    "PhoneHint": "10-digit mobile number, e.g. 9876543210"
  },
  "Seed": {
    "DemoData": false,
    "AdminEmail": "admin@acxiomcrm.local"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
