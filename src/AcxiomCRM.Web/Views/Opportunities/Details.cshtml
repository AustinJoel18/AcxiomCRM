@model OpportunityDetailsViewModel
@{
    var o = Model.Opportunity;
    ViewData["Title"] = o.OpportunityName;
    var active = OpportunityRules.IsActive(o.Stage);
}
<div class="page-header">
    <div>
        <div class="crumbs"><a asp-action="Index">Opportunities</a> / #@o.OpportunityId</div>
        <h1 class="d-flex align-items-center gap-2 flex-wrap">@o.OpportunityName @Ui.Badge(o.Stage)</h1>
        <div class="subtitle"><a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId">@o.CustomerName</a> · Owner: @o.AssignedToName</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@o.OpportunityId"><i class="bi bi-pencil me-1"></i>Edit</a>
        @if (Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" data-confirm="Delete opportunity @o.OpportunityName?">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="kpi-label">Amount</div><div class="kpi-value">@Fmt.Money(o.Amount)</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="kpi-label">Probability</div><div class="kpi-value">@o.Probability%</div>
        <div class="progress mt-2" role="progressbar" aria-label="Probability" aria-valuenow="@o.Probability" aria-valuemin="0" aria-valuemax="100" style="height:6px"><div class="progress-bar" style="width:@o.Probability%"></div></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="kpi-label">Weighted value</div><div class="kpi-value">@Fmt.Money(o.WeightedAmount)</div><div class="kpi-sub">Amount × Probability ÷ 100</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="kpi-label">@(active ? "Expected close" : "Closed")</div>
        <div class="kpi-value">@(active ? Fmt.Date(o.ExpectedCloseDate) : Fmt.Date(o.ClosedDate is { } cd ? Clock.ToLocal(cd) : null))</div>
        @if (active && o.ExpectedCloseDate < Clock.Today) { <div class="kpi-sub text-danger"><i class="bi bi-exclamation-circle"></i> Date has passed — update it</div> }</div></div></div>
</div>

<div class="row g-3">
    <div class="col-xl-8 d-flex flex-column gap-3">
        <div class="card"><div class="card-body">
            <dl class="dl-grid">
                <div><dt>Customer</dt><dd><a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId">@o.CustomerName</a></dd></div>
                <div><dt>Lead</dt><dd>@if (o.LeadId is { } lid) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@lid">@o.LeadName</a> } else { <span>—</span> }</dd></div>
                <div><dt>Source</dt><dd>@Fmt.Humanize(o.Source)</dd></div>
                <div><dt>Status</dt><dd>@Ui.Badge(o.Status)</dd></div>
                <div><dt>Created</dt><dd>@Fmt.DateTime(Clock.ToLocal(o.CreatedDate))</dd></div>
                @if (!string.IsNullOrEmpty(o.CloseReason)) { <div><dt>Final outcome</dt><dd>@o.CloseReason</dd></div> }
            </dl>
            @if (!string.IsNullOrEmpty(o.Notes)) { <hr /><div class="small text-body-secondary fw-semibold mb-1">NOTES</div><p class="mb-0" style="white-space:pre-line">@o.Notes</p> }
        </div></div>
        @{ ViewData["RelatedKey"] = $"Opportunity:{o.OpportunityId}"; }
        <partial name="_FollowUpList" model="Model.FollowUps" view-data="ViewData" />
        <partial name="_ActivityList" model="Model.Activities" view-data="ViewData" />
    </div>
    <div class="col-xl-4 d-flex flex-column gap-3">
        @if (active)
        {
            <div class="card"><div class="card-body">
                <h2 class="form-section-title">Move through the pipeline</h2>
                <form asp-action="ChangeStage" asp-route-id="@o.OpportunityId" method="post">
                    <div class="mb-2">
                        <label class="form-label" for="StageChange_Stage">Stage</label>
                        <select class="form-select" id="StageChange_Stage" name="StageChange.Stage">
                            @foreach (var s in Enum.GetValues<OpportunityStage>().Where(s => s != o.Stage)) { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="StageChange_CloseReason">Outcome notes <span class="fw-normal text-body-secondary">(required for Lost)</span></label>
                        <textarea class="form-control" id="StageChange_CloseReason" name="StageChange.CloseReason" rows="2" maxlength="500"></textarea>
                    </div>
                    <button class="btn btn-outline-primary btn-sm" type="submit">Update stage</button>
                </form>
            </div></div>
        }
        <partial name="_History" model="Model.History" />
    </div>
</div>
