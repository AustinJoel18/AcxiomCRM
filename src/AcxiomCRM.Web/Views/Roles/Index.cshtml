@model RolesViewModel
@{ ViewData["Title"] = "Roles & permissions"; }
<div class="page-header"><div><h1>Roles &amp; permissions</h1><div class="subtitle">Three fixed roles; every user holds exactly one. Authorization is enforced on the server for pages, records and API endpoints.</div></div></div>
<div class="row g-3 mb-3">
    @foreach (var r in Model.Roles)
    {
        <div class="col-md-4"><div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <h2 class="h5 mb-1">@r.DisplayName</h2>
                <a class="small" asp-controller="Users" asp-action="Index" asp-route-role="@r.Name">@r.UserCount users</a>
            </div>
            <div class="small text-body-secondary mb-2">@r.ActiveUserCount active</div>
            <p class="small mb-0">@r.Description</p>
        </div></div></div>
    }
</div>
<div class="card">
    <div class="card-header">Permission matrix</div>
    <div class="table-responsive"><table class="table table-crm">
        <thead><tr><th>Module</th><th>Admin</th><th>Manager</th><th>Sales Executive</th></tr></thead>
        <tbody>
        @foreach (var m in Model.Matrix)
        {
            <tr><td class="fw-semibold">@m.Module</td><td>@m.Admin</td><td>@m.Manager</td><td>@(m.Sales == "No" ? Ui.Badge("Inactive", "No") : new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(m.Sales)))</td></tr>
        }
        </tbody>
    </table></div>
</div>
