@model LeadFormViewModel
@using Microsoft.Extensions.Options
@inject IOptions<CrmValidationOptions> V
@{
    var isEdit = Model.LeadId is not null;
    ViewData["Title"] = isEdit ? "Edit lead" : "New lead";
}
<div class="page-header">
    <div>
        <div class="crumbs"><a asp-action="Index">Leads</a> / @(isEdit ? Model.LeadCode : "New")</div>
        <h1>@ViewData["Title"]</h1>
    </div>
</div>
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.LeadId" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card"><div class="card-body">
                <h2 class="form-section-title">Contact</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LeadName" class="form-label"></label><span class="req">*</span>
                        <input asp-for="LeadName" class="form-control" maxlength="100" />
                        <span asp-validation-for="LeadName"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label"></label>
                        <input asp-for="CompanyName" class="form-control" maxlength="150" />
                        <span asp-validation-for="CompanyName"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" maxlength="150" />
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" type="tel" inputmode="numeric" maxlength="15" />
                        <div class="form-text">@V.Value.PhoneHint. Provide an email, a phone, or both.</div>
                        <span asp-validation-for="Phone"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="4" maxlength="2000"></textarea>
                        <span asp-validation-for="Notes"></span>
                    </div>
                </div>
            </div></div>
        </div>
        <div class="col-xl-4">
            <div class="card"><div class="card-body">
                <h2 class="form-section-title">Qualification</h2>
                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label><span class="req">*</span>
                    <select asp-for="Status" class="form-select" asp-items="Model.StatusOptions"></select>
                    <div class="form-text">Only valid workflow transitions are offered. Use <em>Convert</em> for qualified leads.</div>
                    <span asp-validation-for="Status"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Source" class="form-label"></label><span class="req">*</span>
                    <select asp-for="Source" class="form-select" asp-items="Ui.EnumOptions<LeadSource>()"><option value="">Select…</option></select>
                    <span asp-validation-for="Source"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Priority" class="form-label"></label><span class="req">*</span>
                    <select asp-for="Priority" class="form-select" asp-items="Ui.EnumOptions<LeadPriority>()"></select>
                    <span asp-validation-for="Priority"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ExpectedValue" class="form-label"></label>
                    <div class="input-group"><span class="input-group-text">₹</span><input asp-for="ExpectedValue" class="form-control" type="number" min="0" step="0.01" /></div>
                    <span asp-validation-for="ExpectedValue"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="AssignedToId" class="form-label"></label>
                    <select asp-for="AssignedToId" class="form-select" asp-items="Model.Owners"></select>
                    <span asp-validation-for="AssignedToId"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save lead</button>
                    <a class="btn btn-light" asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@Model.LeadId">Cancel</a>
                </div>
            </div></div>
        </div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
