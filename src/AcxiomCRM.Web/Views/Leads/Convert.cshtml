@model LeadConvertViewModel
@{
    ViewData["Title"] = "Convert lead";
    var l = Model.Lead;
}
<div class="page-header">
    <div>
        <div class="crumbs"><a asp-action="Index">Leads</a> / <a asp-action="Details" asp-route-id="@l.LeadId">@l.LeadCode</a> / Convert</div>
        <h1>Convert lead: @l.LeadName</h1>
        <div class="subtitle">Creates (or links) a customer, optionally opens an opportunity, and marks the lead as Converted. The conversion is recorded in the audit log.</div>
    </div>
</div>
<form asp-action="Convert" asp-route-id="@l.LeadId" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-xl-7">
            <div class="card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="form-section-title mb-0">1. Customer</h2>
                    <div class="form-check form-switch">
                        <input asp-for="UseExistingCustomer" class="form-check-input" role="switch" data-toggle-target="#existingCustomer" />
                        <label asp-for="UseExistingCustomer" class="form-check-label small"></label>
                    </div>
                </div>
                <div id="existingCustomer" class="mb-2">
                    <label asp-for="ExistingCustomerId" class="form-label"></label>
                    <select asp-for="ExistingCustomerId" class="form-select" asp-items="Model.Customers"><option value="">Select a customer…</option></select>
                    <span asp-validation-for="ExistingCustomerId"></span>
                </div>
                <input type="checkbox" class="d-none" checked="@Model.UseExistingCustomer" data-toggle-target="#newCustomer" data-toggle-invert id="newCustomerMirror" aria-hidden="true" tabindex="-1" />
                <div id="newCustomer" class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Customer.CustomerName" class="form-label"></label><span class="req">*</span>
                        <input asp-for="Customer.CustomerName" class="form-control" />
                        <span asp-validation-for="Customer.CustomerName"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Customer.CompanyName" class="form-label"></label>
                        <input asp-for="Customer.CompanyName" class="form-control" />
                        <span asp-validation-for="Customer.CompanyName"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Customer.Email" class="form-label"></label><span class="req">*</span>
                        <input asp-for="Customer.Email" class="form-control" type="email" />
                        <span asp-validation-for="Customer.Email"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Customer.Phone" class="form-label"></label><span class="req">*</span>
                        <input asp-for="Customer.Phone" class="form-control" type="tel" inputmode="numeric" />
                        <span asp-validation-for="Customer.Phone"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Customer.City" class="form-label"></label>
                        <input asp-for="Customer.City" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Customer.State" class="form-label"></label>
                        <input asp-for="Customer.State" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Customer.Status" class="form-label"></label>
                        <select asp-for="Customer.Status" class="form-select" asp-items="Ui.EnumOptions<CustomerStatus>()"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Customer.AssignedToId" class="form-label"></label>
                        <select asp-for="Customer.AssignedToId" class="form-select" asp-items="Model.Owners"></select>
                        <span asp-validation-for="Customer.AssignedToId"></span>
                    </div>
                    <input type="hidden" asp-for="Customer.Notes" />
                </div>
            </div></div>
        </div>
        <div class="col-xl-5">
            <div class="card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="form-section-title mb-0">2. Opportunity</h2>
                    <div class="form-check form-switch">
                        <input asp-for="CreateOpportunity" class="form-check-input" role="switch" data-toggle-target="#newOpportunity" />
                        <label asp-for="CreateOpportunity" class="form-check-label small"></label>
                    </div>
                </div>
                <div id="newOpportunity" class="row g-3">
                    <div class="col-12">
                        <label asp-for="Opportunity.OpportunityName" class="form-label"></label><span class="req">*</span>
                        <input asp-for="Opportunity.OpportunityName" class="form-control" />
                        <span asp-validation-for="Opportunity.OpportunityName"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Opportunity.Amount" class="form-label"></label><span class="req">*</span>
                        <div class="input-group"><span class="input-group-text">₹</span><input asp-for="Opportunity.Amount" class="form-control" type="number" step="0.01" min="0" /></div>
                        <span asp-validation-for="Opportunity.Amount"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Opportunity.Probability" class="form-label"></label><span class="req">*</span>
                        <div class="input-group"><input asp-for="Opportunity.Probability" class="form-control" type="number" /><span class="input-group-text">%</span></div>
                        <span asp-validation-for="Opportunity.Probability"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Opportunity.ExpectedCloseDate" class="form-label"></label><span class="req">*</span>
                        <input asp-for="Opportunity.ExpectedCloseDate" class="form-control" min="@Clock.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Opportunity.ExpectedCloseDate"></span>
                    </div>
                </div>
            </div></div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-success"><i class="bi bi-arrow-right-circle me-1"></i>Convert lead</button>
                <a class="btn btn-light" asp-action="Details" asp-route-id="@l.LeadId">Cancel</a>
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lead-convert.js" asp-append-version="true"></script>
}
