@model LeadDetailsViewModel
@{
    var l = Model.Lead;
    ViewData["Title"] = l.LeadName;
    string[] steps = ["New", "Contacted", "Qualified", "Converted"];
    var stepIndex = Array.IndexOf(steps, l.Status.ToString());
}
<div class="page-header">
    <div>
        <div class="crumbs"><a asp-action="Index">Leads</a> / @l.LeadCode</div>
        <h1 class="d-flex align-items-center gap-2">@l.LeadName @Ui.Badge(l.Status) @Ui.Badge(l.Priority, l.Priority + " priority")</h1>
        <div class="subtitle">@(l.CompanyName ?? "No company") · Source: @Fmt.Humanize(l.Source) · Assigned to @l.AssignedToName</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (l.CanConvert)
        {
            <a class="btn btn-success" asp-action="Convert" asp-route-id="@l.LeadId"><i class="bi bi-arrow-right-circle me-1"></i>Convert lead</a>
        }
        @if (l.Status != LeadStatus.Converted)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@l.LeadId"><i class="bi bi-pencil me-1"></i>Edit</a>
        }
        @if (Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" data-confirm="Delete lead @l.LeadName?">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        }
    </div>
</div>

@if (l.Status is not (LeadStatus.Lost or LeadStatus.Unqualified))
{
    <div class="card mb-3"><div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-center gap-2 small" aria-label="Lead workflow">
            @for (var i = 0; i < steps.Length; i++)
            {
                var done = i <= stepIndex;
                <span class="badge @(done ? "badge-soft-success" : "badge-soft-secondary") py-2 px-3"><i class="bi @(done ? "bi-check-circle-fill" : "bi-circle") me-1"></i>@steps[i]</span>
                @if (i < steps.Length - 1) { <i class="bi bi-chevron-right text-body-secondary"></i> }
            }
        </div>
    </div></div>
}

<div class="row g-3">
    <div class="col-xl-8 d-flex flex-column gap-3">
        <div class="card"><div class="card-body">
            <dl class="dl-grid">
                <div><dt>Lead code</dt><dd>@l.LeadCode</dd></div>
                <div><dt>Email</dt><dd>@(l.Email ?? "—")</dd></div>
                <div><dt>Phone</dt><dd>@(l.Phone ?? "—")</dd></div>
                <div><dt>Expected value</dt><dd>@Fmt.Money(l.ExpectedValue)</dd></div>
                <div><dt>Created</dt><dd>@Fmt.DateTime(Clock.ToLocal(l.CreatedDate))</dd></div>
                <div><dt>Assigned to</dt><dd>@l.AssignedToName</dd></div>
                @if (l.Status == LeadStatus.Converted)
                {
                    <div><dt>Converted</dt><dd>@(l.ConvertedDate is { } cd ? Fmt.DateTime(Clock.ToLocal(cd)) : "—")</dd></div>
                    <div><dt>Customer</dt><dd>@if (l.ConvertedCustomerId is { } cid) { <a asp-controller="Customers" asp-action="Details" asp-route-id="@cid">@l.ConvertedCustomerName</a> }</dd></div>
                    @if (l.ConvertedOpportunityId is { } oid) { <div><dt>Opportunity</dt><dd><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@oid">#@oid</a></dd></div> }
                }
            </dl>
            @if (!string.IsNullOrEmpty(l.Notes)) { <hr /><div class="small text-body-secondary fw-semibold mb-1">NOTES</div><p class="mb-0" style="white-space:pre-line">@l.Notes</p> }
        </div></div>
        @{ ViewData["RelatedKey"] = $"Lead:{l.LeadId}"; }
        <partial name="_FollowUpList" model="Model.FollowUps" view-data="ViewData" />
        <partial name="_ActivityList" model="Model.Activities" view-data="ViewData" />
    </div>
    <div class="col-xl-4 d-flex flex-column gap-3">
        @if (l.AllowedNextStatuses.Count > 0)
        {
            <div class="card"><div class="card-body">
                <h2 class="form-section-title">Change status</h2>
                <form asp-action="ChangeStatus" asp-route-id="@l.LeadId" method="post">
                    <div class="mb-2">
                        <label class="form-label" for="StatusChange_Status">New status</label>
                        <select class="form-select" id="StatusChange_Status" name="StatusChange.Status" required>
                            @foreach (var s in l.AllowedNextStatuses) { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="StatusChange_Remarks">Remarks</label>
                        <textarea class="form-control" id="StatusChange_Remarks" name="StatusChange.Remarks" rows="2" maxlength="500"></textarea>
                    </div>
                    <button class="btn btn-outline-primary btn-sm" type="submit">Update status</button>
                </form>
            </div></div>
        }
        <partial name="_History" model="Model.History" />
    </div>
</div>
