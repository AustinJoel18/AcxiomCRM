@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var d = Model.Data;
    var period = d.Filter.Period ?? "all";
    var name = User.FindFirst(AppClaimTypes.FullName)?.Value?.Split(' ')[0];
    string PeriodClass(string p) => string.Equals(period, p, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary";
}
<div class="page-header">
    <div>
        <h1>Good @(Clock.Now.Hour < 12 ? "morning" : Clock.Now.Hour < 17 ? "afternoon" : "evening"), @name</h1>
        <div class="subtitle">
            @(Model.IsAdmin ? "Organisation-wide overview" : Model.IsManager ? "Your team's pipeline and performance" : "Your customers, leads and upcoming work")
            · <span class="badge badge-soft-secondary">Scope: @d.ScopeDescription</span>
            · <span class="badge badge-soft-info">@d.PeriodLabel</span>
        </div>
    </div>
    <div class="period-tabs d-flex flex-wrap gap-1" role="group" aria-label="Date filter">
        <a class="btn btn-sm @PeriodClass("all")" asp-route-period="all">All time</a>
        <a class="btn btn-sm @PeriodClass("today")" asp-route-period="today">Today</a>
        <a class="btn btn-sm @PeriodClass("week")" asp-route-period="week">This Week</a>
        <a class="btn btn-sm @PeriodClass("month")" asp-route-period="month">This Month</a>
        <a class="btn btn-sm @PeriodClass("year")" asp-route-period="year">This Year</a>
        <button type="button" class="btn btn-sm @PeriodClass("custom")" data-period-custom>Custom…</button>
    </div>
</div>

<form id="customRange" method="get" class="filter-bar row g-2 align-items-end @(period == "custom" ? "" : "d-none")">
    <input type="hidden" name="period" value="custom" />
    <div class="col-sm-4 col-md-3"><label class="form-label" for="from">From</label><input id="from" name="from" type="date" class="form-control form-control-sm" value="@d.Filter.From?.ToString("yyyy-MM-dd")" /></div>
    <div class="col-sm-4 col-md-3"><label class="form-label" for="to">To</label><input id="to" name="to" type="date" class="form-control form-control-sm" value="@d.Filter.To?.ToString("yyyy-MM-dd")" /></div>
    <div class="col-sm-4 col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit">Apply</button></div>
</form>

@* ---------------------------------------------------------------- KPI cards *@
<div class="row g-3 mb-3">
    @{
        var cards = new (string Label, string Value, string Sub, string Icon, string Tone, string Url)[]
        {
            ("Total Customers", Fmt.Number(d.TotalCustomers), "Visible to you", "bi-building", "tone-blue", Url.Action("Index", "Customers")!),
            ("Total Leads", Fmt.Number(d.TotalLeads), $"{d.OpenLeads} open", "bi-person-lines-fill", "tone-violet", Url.Action("Index", "Leads")!),
            ("Open Leads", Fmt.Number(d.OpenLeads), "New · Contacted · Qualified", "bi-person-plus", "tone-amber", Url.Action("Index", "Leads")!),
            ("Total Opportunities", Fmt.Number(d.TotalOpportunities), "In scope for period", "bi-briefcase", "tone-slate", Url.Action("Index", "Opportunities")!),
            ("Open Opportunities", Fmt.Number(d.OpenOpportunities), "Qualification → Negotiation", "bi-hourglass-split", "tone-blue", Url.Action("Index", "Opportunities", new { status = "Open" })!),
            ("Won Opportunities", Fmt.Number(d.WonOpportunities), Fmt.MoneyShort(d.WonAmount) + " closed won", "bi-trophy", "tone-green", Url.Action("Index", "Opportunities", new { stage = "Won" })!),
            ("Lost Opportunities", Fmt.Number(d.LostOpportunities), "Closed lost", "bi-x-octagon", "tone-red", Url.Action("Index", "Opportunities", new { stage = "Lost" })!),
            ("Total Pipeline Value", Fmt.MoneyShort(d.TotalPipelineValue), "Weighted " + Fmt.MoneyShort(d.WeightedPipelineValue), "bi-funnel", "tone-violet", Url.Action("Pipeline", "Opportunities")!)
        };
    }
    @foreach (var c in cards)
    {
        <div class="col-6 col-md-4 col-xl-3">
            <a class="kpi-link" href="@c.Url">
                <div class="card h-100"><div class="card-body kpi">
                    <span class="kpi-icon @c.Tone"><i class="bi @c.Icon" aria-hidden="true"></i></span>
                    <div class="min-w-0">
                        <div class="kpi-label">@c.Label</div>
                        <div class="kpi-value">@c.Value</div>
                        <div class="kpi-sub text-truncate">@c.Sub</div>
                    </div>
                </div></div>
            </a>
        </div>
    }
</div>

@* ---------------------------------------------------------------- charts *@
<script type="application/json" id="dashboard-data">@Html.Raw(Model.ChartJson)</script>
<div class="row g-3 mb-3">
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header">Leads by status</div>
            <div class="card-body">
                <div class="chart-box"><canvas id="leadStatusChart" role="img" aria-label="Bar chart of leads by status"></canvas></div>
                <details class="chart-table"><summary>View as table</summary>
                    <table class="table table-sm"><thead><tr><th>Status</th><th class="text-end">Leads</th></tr></thead><tbody>
                    @foreach (var p in d.LeadStatus) { <tr><td>@p.Label</td><td class="text-end">@p.Value.ToString("0")</td></tr> }
                    </tbody></table>
                </details>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header">Opportunity pipeline by stage <span class="fw-normal text-body-secondary small">(amount)</span></div>
            <div class="card-body">
                <div class="chart-box"><canvas id="pipelineChart" role="img" aria-label="Bar chart of opportunity amount by stage"></canvas></div>
                <details class="chart-table"><summary>View as table</summary>
                    <table class="table table-sm"><thead><tr><th>Stage</th><th class="text-end">Count</th><th class="text-end">Amount</th><th class="text-end">Weighted</th></tr></thead><tbody>
                    @foreach (var p in d.Pipeline) { <tr><td>@p.Stage</td><td class="text-end">@p.Count</td><td class="text-end">@Fmt.Money(p.Amount)</td><td class="text-end">@Fmt.Money(p.WeightedAmount)</td></tr> }
                    </tbody></table>
                </details>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header">Monthly sales <span class="fw-normal text-body-secondary small">(won amount)</span></div>
            <div class="card-body">
                <div class="chart-box"><canvas id="monthlyChart" role="img" aria-label="Bar chart of won sales amount per month"></canvas></div>
                <details class="chart-table"><summary>View as table</summary>
                    <table class="table table-sm"><thead><tr><th>Month</th><th class="text-end">Won</th><th class="text-end">Deals won</th><th class="text-end">Deals lost</th></tr></thead><tbody>
                    @foreach (var m in d.MonthlySales) { <tr><td>@m.Month</td><td class="text-end">@Fmt.Money(m.WonAmount)</td><td class="text-end">@m.WonCount</td><td class="text-end">@m.LostCount</td></tr> }
                    </tbody></table>
                </details>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    @* Follow-ups: everyone *@
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar-check text-body-secondary me-1"></i> Follow-ups
                    <span class="badge badge-soft-info ms-1">@d.PendingFollowUps pending</span>
                    @if (d.OverdueFollowUps > 0) { <span class="badge badge-soft-danger ms-1">@d.OverdueFollowUps overdue</span> }
                </span>
                <a class="small" asp-controller="FollowUps" asp-action="Index" asp-route-view="pending">View all</a>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var f in d.OverdueList.Concat(d.UpcomingFollowUps).Take(8))
                {
                    <a class="list-group-item list-group-item-action d-flex gap-3 align-items-center" asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId">
                        <i class="bi @Ui.Icon(f.FollowUpType) @(f.IsOverdue ? "text-danger" : "text-primary")"></i>
                        <span class="flex-grow-1 min-w-0">
                            <span class="d-block fw-semibold small text-truncate">@f.Subject</span>
                            <span class="row-sub">@(f.RelatedName ?? "—") · @f.AssignedToName</span>
                        </span>
                        <span class="text-end small text-nowrap">
                            @Fmt.DateTime(f.FollowUpDate)
                            @if (f.IsOverdue) { <span class="d-block">@Ui.Badge("Overdue")</span> }
                        </span>
                    </a>
                }
                @if (!d.OverdueList.Any() && !d.UpcomingFollowUps.Any())
                {
                    <div class="empty-state"><i class="bi bi-calendar2-check"></i>No pending follow-ups.</div>
                }
            </div>
        </div>
    </div>

    @if (Model.IsSales)
    {
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between"><span><i class="bi bi-person-lines-fill text-body-secondary me-1"></i> My recent leads</span><a class="small" asp-controller="Leads" asp-action="Index">View all</a></div>
                <div class="table-responsive">
                    <table class="table table-crm">
                        <thead><tr><th>Lead</th><th>Status</th><th class="num">Expected</th></tr></thead>
                        <tbody>
                        @foreach (var l in d.RecentLeads)
                        {
                            <tr>
                                <td><a class="row-title" asp-controller="Leads" asp-action="Details" asp-route-id="@l.LeadId">@l.LeadName</a><div class="row-sub">@(l.CompanyName ?? l.LeadCode)</div></td>
                                <td>@Ui.Badge(l.Status)</td>
                                <td class="num">@Fmt.Money(l.ExpectedValue)</td>
                            </tr>
                        }
                        @if (d.RecentLeads.Count == 0) { <tr><td colspan="3" class="empty-state">No leads assigned yet.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between"><span><i class="bi bi-people text-body-secondary me-1"></i> @(Model.IsAdmin ? "Owner performance" : "Team performance")</span><a class="small" asp-controller="Reports" asp-action="Pipeline">Pipeline report</a></div>
                <div class="table-responsive">
                    <table class="table table-crm">
                        <thead><tr><th>Owner</th><th class="num">Open</th><th class="num">Pipeline</th><th class="num">Weighted</th><th class="num">Won</th></tr></thead>
                        <tbody>
                        @foreach (var o in d.TeamPerformance.Take(8))
                        {
                            <tr><td class="fw-semibold">@o.OwnerName</td><td class="num">@o.OpenCount</td><td class="num">@Fmt.MoneyShort(o.OpenAmount)</td><td class="num">@Fmt.MoneyShort(o.WeightedAmount)</td><td class="num">@Fmt.MoneyShort(o.WonAmount)</td></tr>
                        }
                        @if (d.TeamPerformance.Count == 0) { <tr><td colspan="5" class="empty-state">No opportunities yet.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.IsAdmin && d.Users is { } u)
    {
        <div class="col-xl-5">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-shield-check text-body-secondary me-1"></i> Users &amp; security</div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col-6 col-md-3"><div class="kpi-value">@u.Total</div><div class="kpi-label">Users</div></div>
                        <div class="col-6 col-md-3"><div class="kpi-value">@u.Active</div><div class="kpi-label">Active</div></div>
                        <div class="col-6 col-md-3"><div class="kpi-value">@u.Inactive</div><div class="kpi-label">Inactive</div></div>
                        <div class="col-6 col-md-3"><div class="kpi-value @(u.LockedOut > 0 ? "text-danger" : "")">@u.LockedOut</div><div class="kpi-label">Locked</div></div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between small"><span><i class="bi bi-x-circle text-danger me-1"></i>Failed sign-ins (24h)</span><strong>@d.FailedLogins24h</strong></div>
                    <div class="d-flex justify-content-between small mt-2"><span><i class="bi bi-lock text-danger me-1"></i>Lockouts (24h)</span><strong>@d.Lockouts24h</strong></div>
                    <a class="btn btn-sm btn-outline-secondary mt-3" asp-controller="Users" asp-action="Index">Manage users</a>
                </div>
            </div>
        </div>
        <div class="col-xl-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between"><span><i class="bi bi-clock-history text-body-secondary me-1"></i> Recent activity</span><a class="small" asp-controller="AuditLogs" asp-action="Index">Audit log</a></div>
                <div class="table-responsive">
                    <table class="table table-crm">
                        <tbody>
                        @foreach (var a in d.RecentAudit)
                        {
                            <tr>
                                <td class="text-nowrap small text-body-secondary">@Fmt.DateTime(Clock.ToLocal(a.CreatedDate))</td>
                                <td class="small">@(a.UserName ?? "system")</td>
                                <td>@Ui.Badge(a.Result, Fmt.Humanize(a.Action))</td>
                                <td class="small text-truncate" style="max-width:260px">@(a.Details ?? $"{a.EntityName} #{a.RecordId}")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
}
