@model CustomerDetailsViewModel
@{
    var c = Model.Customer;
    ViewData["Title"] = c.CustomerName;
    var key = $"Customer:{c.CustomerId}";
    var open = Model.Opportunities.Where(o => o.Status == OpportunityStatus.Open).ToList();
}
<div class="page-header">
    <div>
        <div class="crumbs"><a asp-action="Index">Customers</a> / @c.CustomerCode</div>
        <h1 class="d-flex align-items-center gap-2">@c.CustomerName @Ui.Badge(c.Status)</h1>
        <div class="subtitle">@(c.CompanyName ?? "Individual customer") · Owner: @c.AssignedToName</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.CustomerId"><i class="bi bi-briefcase me-1"></i>New opportunity</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@c.CustomerId"><i class="bi bi-pencil me-1"></i>Edit</a>
        @if (Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" data-confirm="Delete customer @c.CustomerName? The record will be deactivated and kept in the audit history.">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8 d-flex flex-column gap-3">
        <div class="card"><div class="card-body">
            <dl class="dl-grid">
                <div><dt>Customer code</dt><dd>@c.CustomerCode</dd></div>
                <div><dt>Email</dt><dd><a href="mailto:@c.Email">@c.Email</a></dd></div>
                <div><dt>Phone</dt><dd><a href="tel:@c.Phone">@c.Phone</a></dd></div>
                <div><dt>Company</dt><dd>@(c.CompanyName ?? "—")</dd></div>
                <div><dt>Address</dt><dd>@(string.Join(", ", new[] { c.Address, c.City, c.State }.Where(x => !string.IsNullOrEmpty(x))) is { Length: > 0 } addr ? addr : "—")</dd></div>
                <div><dt>Owner</dt><dd>@c.AssignedToName</dd></div>
                <div><dt>Created</dt><dd>@Fmt.DateTime(Clock.ToLocal(c.CreatedDate)) <span class="text-body-secondary small">by @(c.CreatedByName ?? "system")</span></dd></div>
                <div><dt>Last modified</dt><dd>@(c.ModifiedDate is { } m ? Fmt.DateTime(Clock.ToLocal(m)) : "—")</dd></div>
                @if (Model.SourceLead is { } lead)
                {
                    <div><dt>Converted from lead</dt><dd><a asp-controller="Leads" asp-action="Details" asp-route-id="@lead.LeadId">@lead.LeadCode</a></dd></div>
                }
            </dl>
            @if (!string.IsNullOrEmpty(c.Notes)) { <hr /><div class="small text-body-secondary fw-semibold mb-1">NOTES</div><p class="mb-0" style="white-space:pre-line">@c.Notes</p> }
        </div></div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-briefcase text-body-secondary me-1"></i> Opportunities <span class="badge badge-soft-info ms-1">@open.Count open · @Fmt.MoneyShort(open.Sum(o => o.Amount))</span></span>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.CustomerId"><i class="bi bi-plus-lg"></i> Add</a>
            </div>
            @if (Model.Opportunities.Count == 0)
            {
                <div class="empty-state py-4"><i class="bi bi-briefcase"></i>No opportunities yet.</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-crm">
                    <thead><tr><th>Opportunity</th><th>Stage</th><th class="num">Amount</th><th class="num">Prob.</th><th>Close date</th></tr></thead>
                    <tbody>
                    @foreach (var o in Model.Opportunities)
                    {
                        <tr>
                            <td><a class="row-title" asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId">@o.OpportunityName</a></td>
                            <td>@Ui.Badge(o.Stage)</td>
                            <td class="num">@Fmt.Money(o.Amount)</td>
                            <td class="num">@o.Probability%</td>
                            <td class="small">@Fmt.Date(o.ExpectedCloseDate)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>

        @{ ViewData["RelatedKey"] = key; }
        <partial name="_FollowUpList" model="Model.FollowUps" view-data="ViewData" />
        <partial name="_ActivityList" model="Model.Activities" view-data="ViewData" />
    </div>
    <div class="col-xl-4">
        <partial name="_History" model="Model.History" />
    </div>
</div>
