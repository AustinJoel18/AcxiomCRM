@{
    ViewData["Title"] = "Access denied";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}
<div class="text-center py-5">
    <span class="kpi-icon tone-red mx-auto mb-3" style="width:64px;height:64px;font-size:1.8rem"><i class="bi bi-shield-lock"></i></span>
    <h1 class="h3">Access denied</h1>
    <p class="text-body-secondary mx-auto" style="max-width:32rem">You don't have permission to view this page or record. If you believe this is a mistake, contact your administrator. This attempt has been recorded.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>Back to dashboard</a>
</div>
