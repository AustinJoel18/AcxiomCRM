@model ChangePasswordViewModel
@using Microsoft.Extensions.Options
@inject IOptions<SecurityOptions> Sec
@{
    ViewData["Title"] = "Change password";
    var p = Sec.Value.Password;
}
<div class="page-header"><div><h1>Change password</h1><div class="subtitle">Use a strong password you don't use elsewhere.</div></div></div>
<div class="row"><div class="col-lg-6 col-xl-5">
    @if (Model.IsForced)
    {
        <div class="alert alert-warning d-flex gap-2"><i class="bi bi-shield-exclamation mt-1"></i><div>Your password was reset by an administrator. Please set a new password to continue.</div></div>
    }
    <div class="card"><div class="card-body">
        <form asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least @p.RequiredLength characters with upper/lower case, a number and a symbol. Your last @Sec.Value.PasswordHistoryCount passwords cannot be reused.</div>
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            <button type="submit" class="btn btn-primary">Update password</button>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
