@model RegisterViewModel
@using Microsoft.Extensions.Options
@inject IOptions<SecurityOptions> Sec
@{
    ViewData["Title"] = "Create account";
    Layout = "_AuthLayout";
    var p = Sec.Value.Password;
}
<h1 class="h3 fw-bold mb-1">Create your account</h1>
<p class="text-body-secondary mb-4">New accounts start with the Sales Executive role.</p>

<form asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" autocomplete="name" autofocus />
        <span asp-validation-for="FullName"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="you@company.com" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="pwHelp" />
        <div id="pwHelp" class="form-text">At least @p.RequiredLength characters@(p.RequireUppercase ? ", an uppercase letter" : "")@(p.RequireLowercase ? ", a lowercase letter" : "")@(p.RequireDigit ? ", a number" : "")@(p.RequireNonAlphanumeric ? " and a symbol" : "").</div>
        <span asp-validation-for="Password"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Create account</button>
</form>
<p class="text-center small mt-3 mb-0">Already have an account? <a asp-action="Login">Sign in</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
