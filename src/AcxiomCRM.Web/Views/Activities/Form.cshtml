@model ActivityFormViewModel
@{
    var isEdit = Model.ActivityId is not null;
    ViewData["Title"] = isEdit ? "Edit activity" : "Log activity";
}
<div class="page-header">
    <div>
        <div class="crumbs"><a asp-action="Index">Activities</a> / @(isEdit ? $"#{Model.ActivityId}" : "New")</div>
        <h1>@ViewData["Title"]</h1>
    </div>
</div>
<div class="row"><div class="col-xl-8">
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.ActivityId" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="card"><div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="ActivityType" class="form-label"></label><span class="req">*</span>
                <select asp-for="ActivityType" class="form-select" asp-items="Ui.EnumOptions<ActivityType>()"></select>
                <span asp-validation-for="ActivityType"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Subject" class="form-label"></label><span class="req">*</span>
                <input asp-for="Subject" class="form-control" maxlength="200" />
                <span asp-validation-for="Subject"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ActivityDate" class="form-label"></label><span class="req">*</span>
                <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="ActivityDate"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label"></label><span class="req">*</span>
                <select asp-for="Status" class="form-select" asp-items="Ui.EnumOptions<ActivityStatus>()"></select>
                <span asp-validation-for="Status"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="AssignedToId" class="form-label"></label>
                <select asp-for="AssignedToId" class="form-select" asp-items="Model.Owners"></select>
                <span asp-validation-for="AssignedToId"></span>
            </div>
            <div class="col-12">
                <label asp-for="RelatedKey" class="form-label"></label>
                <select asp-for="RelatedKey" class="form-select" asp-items="Model.RelatedOptions"><option value="">Not linked (general task)</option></select>
                <span asp-validation-for="RelatedKey"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save activity</button>
            <a class="btn btn-light" asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@Model.ActivityId">Cancel</a>
        </div>
    </div></div>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
