@model ActivityDetailsViewModel
@{
    var a = Model.Activity;
    ViewData["Title"] = a.Subject;
}
<div class="page-header">
    <div>
        <div class="crumbs"><a asp-action="Index">Activities</a> / #@a.ActivityId</div>
        <h1 class="d-flex align-items-center gap-2"><i class="bi @Ui.Icon(a.ActivityType) text-primary"></i>@a.Subject @Ui.Badge(a.Status)</h1>
        <div class="subtitle">@a.ActivityType · @Fmt.DateTime(a.ActivityDate) · @a.AssignedToName</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@a.ActivityId"><i class="bi bi-pencil me-1"></i>Edit</a>
        @if (Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-id="@a.ActivityId" method="post" data-confirm="Delete this activity?">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        }
    </div>
</div>
<div class="row g-3">
    <div class="col-xl-8">
        <div class="card"><div class="card-body">
            <dl class="dl-grid">
                <div><dt>Type</dt><dd>@a.ActivityType</dd></div>
                <div><dt>Date</dt><dd>@Fmt.DateTime(a.ActivityDate)</dd></div>
                <div><dt>Status</dt><dd>@Ui.Badge(a.Status)</dd></div>
                <div><dt>Related to</dt><dd>@if (a.RelatedType is { } rt) { <a asp-controller="@Ui.RelatedController(rt)" asp-action="Details" asp-route-id="@a.RelatedId">@a.RelatedName</a> <span class="small text-body-secondary">(@rt)</span> } else { <span>—</span> }</dd></div>
                <div><dt>Assigned to</dt><dd>@a.AssignedToName</dd></div>
                @if (a.FollowUpId is { } fid) { <div><dt>From follow-up</dt><dd><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@fid">#@fid</a></dd></div> }
            </dl>
            @if (!string.IsNullOrEmpty(a.Description)) { <hr /><p class="mb-0" style="white-space:pre-line">@a.Description</p> }
        </div></div>
    </div>
    <div class="col-xl-4"><partial name="_History" model="Model.History" /></div>
</div>
