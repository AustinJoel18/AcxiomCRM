@model IReadOnlyList<ActivityDto>
@{ var relatedKey = ViewData["RelatedKey"] as string; }
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="bi bi-journal-text text-body-secondary me-1"></i> Activities</span>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Activities" asp-action="Create" asp-route-relatedKey="@relatedKey"><i class="bi bi-plus-lg"></i> Log activity</a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state py-4"><i class="bi bi-journal"></i>No activities recorded.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var a in Model)
            {
                <li class="list-group-item d-flex gap-3 py-3">
                    <span class="kpi-icon tone-slate" style="width:34px;height:34px;flex-basis:34px;font-size:.95rem"><i class="bi @Ui.Icon(a.ActivityType)"></i></span>
                    <div class="flex-grow-1">
                        <a class="row-title" asp-controller="Activities" asp-action="Details" asp-route-id="@a.ActivityId">@a.Subject</a>
                        <div class="row-sub">@a.ActivityType · @Fmt.DateTime(a.ActivityDate) · @a.AssignedToName</div>
                        @if (!string.IsNullOrEmpty(a.Description)) { <div class="small mt-1">@a.Description</div> }
                    </div>
                    <div>@Ui.Badge(a.Status)</div>
                </li>
            }
        </ul>
    }
</div>
