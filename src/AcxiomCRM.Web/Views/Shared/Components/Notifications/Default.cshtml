@model IReadOnlyList<FollowUpDto>
@{
    var overdue = (int)ViewData["Overdue"]!;
    var dueToday = (int)ViewData["DueToday"]!;
    var total = overdue + dueToday;
}
<div class="dropdown">
    <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Follow-up reminders: @total">
        <i class="bi bi-bell" aria-hidden="true"></i>
        @if (total > 0)
        {
            <span class="count">@(total > 99 ? "99+" : total)</span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end p-0 shadow" style="width: 340px">
        <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
            <strong class="small">Reminders</strong>
            <span class="small text-body-secondary">@overdue overdue · @dueToday due today</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="p-3 small text-body-secondary text-center">You're all caught up.</div>
        }
        @foreach (var f in Model)
        {
            <a class="notif-item" asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId">
                <i class="bi @Ui.Icon(f.FollowUpType) mt-1 @(f.IsOverdue ? "text-danger" : "text-primary")" aria-hidden="true"></i>
                <span class="flex-grow-1">
                    <span class="d-block small fw-semibold">@f.Subject</span>
                    <span class="when">@(f.RelatedName ?? "—") · @Fmt.DateTime(f.FollowUpDate)</span>
                </span>
                @if (f.IsOverdue) { <span class="badge badge-soft-danger align-self-center">Overdue</span> }
            </a>
        }
        <a class="d-block text-center small py-2" asp-controller="FollowUps" asp-action="Index" asp-route-view="pending" asp-route-assignedToId="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">View my pending follow-ups</a>
    </div>
</div>
