@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}
<div class="text-center py-5">
    <div class="display-5 fw-bold text-body-secondary">@Model.StatusCode</div>
    <h1 class="h3 mt-2">@Model.Title</h1>
    <p class="text-body-secondary">@Model.Message</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small text-body-secondary">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>Back to dashboard</a>
</div>
